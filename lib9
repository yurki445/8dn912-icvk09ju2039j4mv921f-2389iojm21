local function Tween(object, info, properties)
    if not Library.Options.Animations then
        for property, value in pairs(properties) do
            object[property] = value
        end

        return
    end

    local tween = TweenService:Create(object, info, properties)
    tween:Play()

    return tween
end

local function Create(className, properties)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    return object
end

local function Corner(parent, radius)
    local corner = Create("UICorner", {
        CornerRadius = UDim.new(0, radius),
        Parent = parent,
    })

    return corner
end

local function Stroke(parent, thickness, transparency)
    local stroke = Create("UIStroke", {
        Color = Library.Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0.75,
        Parent = parent,
    })

    return stroke
end

local function Shadow(parent)
    local shadow = Instance.new("UIShadow")

    shadow.Offset = UDim2.new(0, 0, 0, 0)
    shadow.BlurRadius = UDim.new(0, 20)
    shadow.Color = Color3.fromRGB(0, 0, 0)
    shadow.ZIndex = -1
    shadow.Transparency = 0.5
    shadow.ShowBehindParent = true
    shadow.Spread = UDim2.new(0, 0, 0, 0)
    shadow.Mode = Enum.ApplyShadowMode.Shape
    shadow.Inset = false
    shadow.Enabled = true
    shadow.Parent = parent

    return shadow
end

local function MakeDraggable(frame, handle)
    local dragging = false
    local dragStart
    local startPosition

    handle = handle or frame

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

local function ResolveKeyCode(value)
    if type(value) == "table" then
        if value.Get then
            value = value:Get()
        else
            value = value.Text
        end
    end

    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
        return value
    end

    if type(value) == "string" and value ~= "" then
        local keyName = string.gsub(value, "%s+", "")
        local directMatch = Enum.KeyCode[keyName]

        if directMatch then
            return directMatch
        end

        for _, keyCode in ipairs(Enum.KeyCode:GetEnumItems()) do
            if string.lower(keyCode.Name) == string.lower(keyName) then
                return keyCode
            end
        end
    end

    return nil
end

local function ResolveUserInputType(value)
    if typeof(value) == "EnumItem"
        and value.EnumType == Enum.UserInputType then
        return value
    end

    if type(value) ~= "string" then
        return nil
    end

    local inputName = string.gsub(value, "%s+", "")

    for _, inputType in ipairs(Enum.UserInputType:GetEnumItems()) do
        if string.lower(inputType.Name) == string.lower(inputName) then
            return inputType
        end
    end

    return nil
end

local function MatchesKeybind(input, keybind)
    local keyCode = ResolveKeyCode(keybind)

    if keyCode then
        return input.KeyCode == keyCode
    end

    local inputType = ResolveUserInputType(keybind)
    return inputType ~= nil and input.UserInputType == inputType
end

local function BindKeybind(keybind, callback)
    if keybind == nil then
        return
    end

    return UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if MatchesKeybind(input, keybind) then
            callback()
        end
    end)
end

