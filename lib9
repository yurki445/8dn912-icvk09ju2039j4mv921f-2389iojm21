                local function RefreshText()
                    Button.Text = "  "
                        .. tostring(options.Name or "Dropdown")
                        .. ": "
                        .. tostring(selected)
                end

                local OpenFrame

                local function Close()
                    if OpenFrame then
                        OpenFrame:Destroy()
                        OpenFrame = nil
                    end
                end

                local function Open()
                    Close()

                    OpenFrame = Create("Frame", {
                        Size = UDim2.new(1, 0, 0, math.min(#values * 30, 150)),

                        BackgroundColor3 = Library.Theme.Secondary,

                        BorderSizePixel = 0,

                        ZIndex = 50,

                        Parent = Elements,
                    })

                    Corner(OpenFrame, 7)

                    local List = Create("UIListLayout", {
                        SortOrder = Enum.SortOrder.LayoutOrder,

                        Parent = OpenFrame,
                    })

                    for _, value in ipairs(values) do
                        local Option = Create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 30),

                            BackgroundTransparency = 1,

                            Text = tostring(value),

                            TextColor3 = Library.Theme.Text,

                            Font = Enum.Font.SourceSans,
                            TextSize = 13,

                            ZIndex = 51,

                            Parent = OpenFrame,
                        })

                        Option.MouseButton1Click:Connect(function()
                            selected = value

                            Library.Flags[
                                options.Flag or options.Name
                            ] = value

                            RefreshText()
                            Close()

                            if options.Callback then
                                options.Callback(value)
                            end
                        end)
                    end
                end

                Button.MouseButton1Click:Connect(function()
                    if OpenFrame then
                        Close()
                    else
                        Open()
                    end
                end)

                function Dropdown:Set(value)
                    if table.find(values, value) then
                        selected = value
                        RefreshText()

                        Library.Flags[
                            options.Flag or options.Name
                        ] = value

                        if options.Callback then
                            options.Callback(value)
                        end
                    end
                end

                function Dropdown:Get()
                    return selected
                end

                RefreshText()

                return Dropdown
            end

