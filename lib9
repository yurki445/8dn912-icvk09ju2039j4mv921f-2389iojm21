            ----------------------------------------------------------------
            -- GRAPH
            ----------------------------------------------------------------

            function Section:CreateGraph(options)
                options = options or {}

                local Graph = {}
                local values = {}
                local maxPoints = options.MaxPoints or 60
                local updateConnection

                local Frame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 150),

                    BackgroundColor3 = Library.Theme.Element,

                    Parent = Elements,
                })

                Corner(Frame, 8)

                local Title = Create("TextLabel", {
                    Size = UDim2.new(1, -20, 0, 25),
                    Position = UDim2.fromOffset(10, 5),

                    BackgroundTransparency = 1,

                    Text = options.Name or "Graph",

                    TextColor3 = Library.Theme.Text,

                    Font = Enum.Font.SourceSansBold,
                    TextSize = 14,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    Parent = Frame,
                })

                local ValueLabel = Create("TextLabel", {
                    Size = UDim2.fromOffset(70, 25),
                    Position = UDim2.new(1, -80, 0, 5),

                    BackgroundTransparency = 1,

                    TextColor3 = Library.Theme.SubText,

                    Font = Enum.Font.SourceSans,
                    TextSize = 13,

                    TextXAlignment = Enum.TextXAlignment.Right,

                    Parent = Frame,
                })

                local GraphArea = Create("Frame", {
                    Size = UDim2.new(1, -20, 1, -40),
                    Position = UDim2.fromOffset(10, 32),

                    BackgroundTransparency = 1,

                    ClipsDescendants = true,

                    Parent = Frame,
                })

                local function ClearGraph()
                    for _, child in ipairs(GraphArea:GetChildren()) do
                        if child:IsA("Frame") then
                            child:Destroy()
                        end
                    end
                end

                local function Render(data)
                    ClearGraph()

                    if #data < 2 then
                        return
                    end

                    local minimum = math.huge
                    local maximum = -math.huge

                    for _, value in ipairs(data) do
                        minimum = math.min(minimum, value)
                        maximum = math.max(maximum, value)
                    end

                    if maximum == minimum then
                        maximum = minimum + 1
                    end

                    for index = 1, #data - 1 do
                        local a = data[index]
                        local b = data[index + 1]

                        local x1 = (index - 1) / (#data - 1)
                        local x2 = index / (#data - 1)

                        local y1 = 1 - ((a - minimum) / (maximum - minimum))
                        local y2 = 1 - ((b - minimum) / (maximum - minimum))

                        local x = x1 * GraphArea.AbsoluteSize.X
                        local y = y1 * GraphArea.AbsoluteSize.Y

                        local nextX = x2 * GraphArea.AbsoluteSize.X
                        local nextY = y2 * GraphArea.AbsoluteSize.Y

                        local distance = math.sqrt(
                            (nextX - x)^2
                            + (nextY - y)^2
                        )

                        local angle = math.deg(
                            math.atan2(
                                nextY - y,
                                nextX - x
                            )
                        )

                        local Line = Create("Frame", {
                            Size = UDim2.fromOffset(distance, 2),

                            Position = UDim2.fromOffset(x, y),

                            AnchorPoint = Vector2.new(0, 0.5),

                            Rotation = angle,

                            BackgroundColor3 = Library.Theme.Accent,

                            BorderSizePixel = 0,

                            Parent = GraphArea,
                        })
                    end
                end

                function Graph:SetData(data)
                    values = {}

                    for index = math.max(1, #data - maxPoints + 1), #data do
                        table.insert(values, data[index])
                    end

                    if values[#values] ~= nil then
                        ValueLabel.Text = string.format("%.1f", values[#values])
                    end

                    Render(values)
                end

                function Graph:Push(value)
                    if type(value) ~= "number" then
                        return
                    end

                    table.insert(values, value)

                    if #values > maxPoints then
                        table.remove(values, 1)
                    end

                    ValueLabel.Text = string.format("%.1f", value)
                    Render(values)
                end

                function Graph:Stop()
                    if updateConnection then
                        updateConnection:Disconnect()
                        updateConnection = nil
                    end
                end

                function Graph:Start(source)
                    Graph:Stop()

                    local elapsed = 0
                    local updateInterval = options.UpdateInterval or 0.1

                    updateConnection = RunService.Heartbeat:Connect(function(deltaTime)
                        if not Frame.Parent then
                            Graph:Stop()
                            return
                        end

                        elapsed = elapsed + deltaTime

                        if elapsed >= updateInterval then
                            elapsed = 0
                            local value = source(deltaTime)
                            Graph:Push(value)
                        end
                    end)
                end

                if type(options.Source) == "function" then
                    Graph:Start(options.Source)
                end

                return Graph
            end

            table.insert(Tab.Sections, Section)

            return Section
        end

        table.insert(Tabs, Tab)

        if not CurrentTab then
            Tab:Select()
        end

        return Tab
    end

