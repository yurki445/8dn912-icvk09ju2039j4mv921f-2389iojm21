    ----------------------------------------------------------------
    -- THEME
    ----------------------------------------------------------------

    function Library:SetTheme(name)
        local theme = Library.Themes[name]

        if not theme then
            return
        end

        Library.Theme = theme

        if not ScreenGui then
            return
        end

        for _, object in ipairs(ScreenGui:GetDescendants()) do
            if object:IsA("UIStroke") then
                object.Color = theme.Stroke

            elseif object:IsA("TextLabel")
                or object:IsA("TextButton")
                or object:IsA("TextBox") then

                if object.Name == "Version"
                    or object.Name == "UserId" then

                    object.TextColor3 = theme.SubText
                else
                    object.TextColor3 = theme.Text
                end
            end
        end
    end

    ----------------------------------------------------------------
    -- CONFIG
    ----------------------------------------------------------------

    function Library:CreateConfig(name)
        name = name or "Default"

        Library.Config[name] = {}

        for flag, value in pairs(Library.Flags) do
            Library.Config[name][flag] = value
        end

        return Library.Config[name]
    end

    function Library:SaveConfig(name)
        name = name or "Default"

        local config = {}

        for flag, value in pairs(Library.Flags) do
            config[flag] = value
        end

        Library.Config[name] = config

        return config
    end

    function Library:LoadConfig(name)
        name = name or "Default"

        local config = Library.Config[name]

        if not config then
            return false
        end

        for flag, value in pairs(config) do
            Library.Flags[flag] = value
        end

        return true
    end

    function Library:DeleteConfig(name)
        Library.Config[name] = nil
    end

    function Library:GetConfig(name)
        return Library.Config[name or "Default"]
    end

    ----------------------------------------------------------------
    -- GLOBAL KEYBIND
    ----------------------------------------------------------------

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if MatchesKeybind(input, Library.Options.Keybind) then
            if ScreenGui then
                ScreenGui.Enabled = not ScreenGui.Enabled
            end
        end
    end)

    ----------------------------------------------------------------
    -- RETURN WINDOW
    ----------------------------------------------------------------

    Window.ScreenGui = ScreenGui
    Window.MainFrame = MainFrame
    Window.Sidebar = Sidebar
    Window.Content = ContentFrame

    WindowObject = Window

    return Window
end

