	--// SET ACCENT

	function WindowObject:SetAccentColor(value)
		local color

		if typeof(value) == "Color3" then
			color = value
		elseif typeof(value) == "string" then
			local colors = {
				Green = Color3.fromRGB(0, 255, 0),
				Blue = Color3.fromRGB(50, 140, 255),
				Purple = Color3.fromRGB(160, 90, 255),
				Red = Color3.fromRGB(255, 70, 70),
			}

			color = colors[value]
		end

		if not color then
			return
		end

		Theme.Accent = color
		Customization.Colors.Accent = color

		if WindowStroke then
			WindowStroke.Color = color
		end

		Avatar.BackgroundColor3 = color
		FooterAvatar.BackgroundColor3 = color
