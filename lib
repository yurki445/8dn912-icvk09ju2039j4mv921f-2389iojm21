		function PanelObj:AddKeybind(config)
			config = config or {}

			local name = config.Name or config.Title or "Keybind"
			local currentKey = config.Default or Enum.KeyCode.Unknown
			local listening = false

			local Row = create("Frame", {
				Name = name,
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundTransparency = 1,
				LayoutOrder = #PanelObj.Elements + 1,
				Parent = Panel,
			})

			local Label = create("TextLabel", {
				Text = name,
				Font = Theme.Font,
				TextSize = Customization.TextSizes.Element,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -100, 1, 0),
				Parent = Row,
			})

			local KeyButton = create("TextButton", {
				Name = "Key",
				Text = currentKey.Name,
				Font = Theme.FontBold,
				TextSize = Customization.TextSizes.Element,
				TextColor3 = Theme.Text,
				AutoButtonColor = false,
				BackgroundColor3 = Theme.Input,
				BackgroundTransparency = Customization.Transparency.Input,
				Size = UDim2.fromOffset(90, 30),
				Position = UDim2.new(1, -90, 0.5, -15),
				Parent = Row,
			}, {
				corner(Customization.Corners.Input),
				stroke(Theme.PanelBorder, 1)
			})

			local function setKey(key, fireCallback)
				currentKey = key
				KeyButton.Text = key.Name

				if fireCallback and config.Callback then
					config.Callback(key)
				end
			end

			KeyButton.MouseButton1Click:Connect(function()
				if listening then
					return
				end

				listening = true
				KeyButton.Text = "Press key..."

				local connection
				connection = UserInputService.InputBegan:Connect(function(
					input,
					gameProcessed
				)
					if gameProcessed then
						return
					end

					if input.UserInputType == Enum.UserInputType.Keyboard then
						setKey(input.KeyCode, true)
						listening = false

						if connection then
							connection:Disconnect()
						end
					end
				end)
			end)

			UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if gameProcessed or listening then
					return
				end

				if
					input.UserInputType == Enum.UserInputType.Keyboard
					and input.KeyCode == currentKey
				then
					if config.Callback then
						config.Callback(currentKey)
					end
				end
			end)

			local KeybindObj = {
				Frame = Row,

				Get = function()
					return currentKey
				end,

				Set = function(_, key)
					if typeof(key) == "EnumItem" then
						setKey(key, true)
					end
				end,
			}

			table.insert(PanelObj.Elements, KeybindObj)

			return KeybindObj
		end

		--// GRAPH -------------------------------------------------------

		function PanelObj:AddGraph(config)
			config = config or {}

			local name = config.Name or config.Title or "Graph"
			local values = config.Values or {}

			local Row = create("Frame", {
				Name = name,
				Size = UDim2.new(1, 0, 0, config.Height or 150),
				BackgroundTransparency = 1,
				LayoutOrder = #PanelObj.Elements + 1,
				Parent = Panel,
			})

			if name ~= "" then
				create("TextLabel", {
					Text = name,
					Font = Theme.Font,
					TextSize = Customization.TextSizes.Element,
					TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 22),
					Parent = Row,
				})
			end

			local Graph = create("Frame", {
				Name = "Graph",
				Size = UDim2.new(1, 0, 1, -26),
				Position = UDim2.fromOffset(0, 26),
				BackgroundColor3 = Theme.Graph,
				BackgroundTransparency = Customization.Transparency.Graph,
				ClipsDescendants = true,
				Parent = Row,
			}, {
				corner(Customization.Corners.Input),
				stroke(Theme.PanelBorder, 1)
			})

			local GraphPoints = {}

			local function clearGraph()
				for _, object in ipairs(GraphPoints) do
					if object and object.Parent then
						object:Destroy()
					end
				end

				table.clear(GraphPoints)
			end

			local function drawGraph(data)
				clearGraph()

				if #data == 0 then
					return
				end

				local minimum = math.huge
				local maximum = -math.huge

				for _, value in ipairs(data) do
					if type(value) == "number" then
						minimum = math.min(minimum, value)
						maximum = math.max(maximum, value)
					end
				end

				if minimum == math.huge then
					return
				end

				if minimum == maximum then
					maximum = minimum + 1
				end

				for index = 1, #data - 1 do
					local a = data[index]
					local b = data[index + 1]

					if type(a) == "number" and type(b) == "number" then
						local x1 = (index - 1) / math.max(#data - 1, 1)
						local x2 = index / math.max(#data - 1, 1)

						local y1 = 1 - ((a - minimum) / (maximum - minimum))
						local y2 = 1 - ((b - minimum) / (maximum - minimum))

						local p1 = Vector2.new(
							x1 * Graph.AbsoluteSize.X,
							y1 * Graph.AbsoluteSize.Y
						)

						local p2 = Vector2.new(
							x2 * Graph.AbsoluteSize.X,
							y2 * Graph.AbsoluteSize.Y
						)

						local distance = (p2 - p1).Magnitude
						local angle = math.deg(
							math.atan2(
								p2.Y - p1.Y,
								p2.X - p1.X
							)
						)

						local segment = create("Frame", {
							AnchorPoint = Vector2.new(0, 0.5),
							Position = UDim2.fromOffset(
								p1.X,
								p1.Y
							),
							Size = UDim2.fromOffset(
								distance,
								2
							),
							Rotation = angle,
							BackgroundColor3 = Theme.Accent,
							BorderSizePixel = 0,
							ZIndex = 2,
							Parent = Graph,
						})

						table.insert(GraphPoints, segment)
					end
				end
			end

			drawGraph(values)

			local GraphObj = {
				Frame = Row,

				SetData = function(_, data)
					if type(data) == "table" then
						values = data
						drawGraph(values)
					end
				end,

				GetData = function()
					return values
				end,
			}

			table.insert(PanelObj.Elements, GraphObj)

			return GraphObj
		end

