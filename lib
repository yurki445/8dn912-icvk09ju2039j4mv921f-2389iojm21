function Lib:CreateWindow(config)
	config = config or {}

	-- Unload an existing copy of this UI before creating a new one.
	-- Change GuiName in the config if you want multiple different UIs.
	local guiName = config.GuiName or "Lib"
	local existingGui = PlayerGui:FindFirstChild(guiName)
	if existingGui and Customization.Behavior.DestroyOldUI then
		existingGui:Destroy()
	end

	if config.Theme then
		local selectedTheme = config.Theme
		if type(selectedTheme) == "string" then
			selectedTheme = Themes[selectedTheme]
		end
		if selectedTheme then
			applyTheme(selectedTheme)
		else
			warn("Lib: unknown theme. Use Lib.Themes to see available themes.")
		end
	end

