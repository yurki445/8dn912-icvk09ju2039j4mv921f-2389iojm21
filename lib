local function applyTheme(theme)
	if not theme then
		return
	end

	Theme.Background = theme.Background or Theme.Background
	Theme.Panel = theme.ElementBackground or Theme.Panel
	Theme.PanelBorder = theme.ElementStroke or Theme.PanelBorder

	Theme.SidebarItem = theme.TabBackground or Theme.SidebarItem
	Theme.SidebarHover = theme.TabBackgroundSelected or Theme.SidebarHover

	Theme.Accent = theme.SliderProgress or Theme.Accent
	Theme.AccentDim = theme.SliderBackground or Theme.AccentDim

	Theme.Text = theme.TextColor or Theme.Text
	Theme.SubText = theme.PlaceholderColor or Theme.SubText

	Theme.SliderTrack = theme.SliderBackground or Theme.SliderTrack
	Theme.SliderFill = theme.SliderProgress or Theme.SliderFill
end

--// HELPERS

local function create(class, props, children)
	local object = Instance.new(class)

	for property, value in pairs(props or {}) do
		object[property] = value
	end

	for _, child in ipairs(children or {}) do
		child.Parent = object
	end

	return object
end

local function corner(radius)
	return create("UICorner", {
		CornerRadius = UDim.new(0, radius),
	})
end

local function stroke(color, transparency)
	return create("UIStroke", {
		Color = color,
		Transparency = transparency or 0,
		Thickness = 1,
	})
end

local function tween(object, properties, duration)
	if not Customization.Animation.Enabled then
		for property, value in pairs(properties) do
			object[property] = value
		end

		return
	end

	local info = TweenInfo.new(
		duration or Customization.Animation.Speed,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	return TweenService:Create(object, info, properties)
end

local function makeText(parent, text, size, font)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size or 20),
		Text = text or "",
		TextColor3 = Theme.Text,
		TextSize = Customization.TextSize.Normal,
		Font = font or Theme.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = parent,
	})
end

local function getAbsoluteContentSize(container)
	local layout = container:FindFirstChildOfClass("UIListLayout")

	if layout then
		return layout.AbsoluteContentSize
	end

	return Vector2.zero
end

