	clickable.MouseButton1Click:Connect(function()
		for _, t in ipairs(self.Tabs) do
			t.Page.Visible = false
			t.Button.BackgroundColor3 = Theme.SidebarItem
		end
		Page.Visible = true
		Button.BackgroundColor3 = Theme.SidebarHover
		self.ActiveTab = Tab
	end)

	table.insert(self.Tabs, Tab)

	-- First tab added becomes active by default
	if #self.Tabs == 1 then
		Page.Visible = true
		Button.BackgroundColor3 = Theme.SidebarHover
		self.ActiveTab = Tab
	end

	return Tab
end

return Lib
