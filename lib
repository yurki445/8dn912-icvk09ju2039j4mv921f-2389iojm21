					or
					(Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch)
				then
					beginDrag(input)
				end
			end)

			table.insert(dragZones, zone)

			return zone
		end

		-- Header and all four sides can start a move.
		makeDragZone(
			"TopDrag",
