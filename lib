			UDim2.new(1, -12, 0, 12)
		)

		makeDragZone(
			"BottomDrag",
			UDim2.new(1, -80, 0, 12),
			UDim2.new(0, 12, 1, -12)
		)

		local ResizeHandle = create("TextButton", {
			Name = "ResizeHandle",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.new(1, -22, 1, -22),
