						ZIndex = 101,

						Parent = List,
					}, {
						corner(4),
					})

					local Padding = create("UIPadding", {
						PaddingLeft = UDim.new(0, 8),
						Parent = OptionButton,
					})

					OptionButton.MouseButton1Click:Connect(function()
						selected = option

						SelectedText.Text = tostring(selected)

						List.Visible = false
						open = false

						if options.Callback then
							options.Callback(selected)
						end
					end)
				end

				Button.MouseButton1Click:Connect(function()
					open = not open
					List.Visible = open
				end)

				local Object = {}

				function Object:Set(value)
					selected = value
					SelectedText.Text = tostring(value)

					if options.Callback then
						options.Callback(value)
					end
				end

				function Object:Get()
					return selected
				end

				return Object
			end

			--// BUTTON

			function PanelObject:AddButton(options)
				options = options or {}

				local Button = create("TextButton", {
					Size = UDim2.new(
						1,
						0,
						0,
						Customization.Size.ButtonHeight
					),

					BackgroundColor3 = options.Accent
						and Theme.Accent
						or Customization.Colors.Button,

					Text = options.Name or "Button",

					TextColor3 = options.Accent
						and Color3.fromRGB(255, 255, 255)
						or Theme.Text,

					TextSize = Customization.TextSize.Button,

					Font = Theme.FontBold,

					AutoButtonColor = false,

					LayoutOrder = 40,

					Parent = PanelContent,
				}, {
					corner(Customization.Corners.Button),
				})

				Button.MouseEnter:Connect(function()
					if options.Accent then
						Button.BackgroundColor3 = Theme.AccentDim
					else
						Button.BackgroundColor3 =
							Customization.Colors.SidebarHover
					end
				end)

				Button.MouseLeave:Connect(function()
					Button.BackgroundColor3 = options.Accent
						and Theme.Accent
						or Customization.Colors.Button
				end)

				Button.MouseButton1Click:Connect(function()
					if options.Callback then
						options.Callback()
					end
				end)

				return Button
			end

			--// TEXTBOX

			function PanelObject:AddTextbox(options)
				options = options or {}

				local Row = create("Frame", {
					Size = UDim2.new(
						1,
						0,
						0,
						58
					),

					BackgroundTransparency = 1,

					LayoutOrder = 50,

					Parent = PanelContent,
				})

				local Label = create("TextLabel", {
					Size = UDim2.new(
						1,
						0,
						0,
						20
					),

					BackgroundTransparency = 1,

					Text = options.Name or "Textbox",

					TextColor3 = Theme.SubText,

					TextSize = Customization.TextSize.Small,

					Font = Theme.Font,

					TextXAlignment = Enum.TextXAlignment.Left,

					Parent = Row,
				})

				local Input = create("TextBox", {
					Position = UDim2.fromOffset(0, 25),

					Size = UDim2.new(
						1,
						0,
						0,
						32
					),

					BackgroundColor3 = Customization.Colors.Input,

					TextColor3 = Theme.Text,

					PlaceholderColor3 = Theme.SubText,

					PlaceholderText = options.Placeholder or "",

					Text = "",

					TextSize = Customization.TextSize.Normal,

					Font = Theme.Font,

					ClearTextOnFocus = false,

					TextXAlignment = Enum.TextXAlignment.Left,

					Parent = Row,
				}, {
					corner(Customization.Corners.Input),
					stroke(Theme.PanelBorder),
				})

				local Padding = create("UIPadding", {
					PaddingLeft = UDim.new(0, 8),
					PaddingRight = UDim.new(0, 8),
					Parent = Input,
				})

				Input.FocusLost:Connect(function(enterPressed)
					if options.Callback then
						options.Callback(Input.Text, enterPressed)
					end
				end)

				local Object = {}

				function Object:Set(text)
					Input.Text = text
				end

				function Object:Get()
					return Input.Text
				end

				return Object
			end

			--// KEYBIND

			function PanelObject:AddKeybind(options)
				options = options or {}

				local current = options.Default or Enum.KeyCode.E
				local listening = false

				local Row = create("TextButton", {
					Size = UDim2.new(
						1,
						0,
						0,
						32
					),

					BackgroundTransparency = 1,

					Text = "",

					AutoButtonColor = false,

					LayoutOrder = 60,

					Parent = PanelContent,
				})

				local Label = create("TextLabel", {
					BackgroundTransparency = 1,

					Size = UDim2.new(
						1,
						-80,
						1,
						0
					),

					Text = options.Name or "Keybind",

					TextColor3 = Theme.Text,

					TextSize = Customization.TextSize.Normal,

					Font = Theme.Font,

					TextXAlignment = Enum.TextXAlignment.Left,

					Parent = Row,
				})

				local Key = create("TextLabel", {
					AnchorPoint = Vector2.new(1, 0.5),

					Position = UDim2.new(
						1,
						0,
						0.5,
						0
					),

					Size = UDim2.fromOffset(65, 24),

					BackgroundColor3 = Theme.SliderTrack,

					Text = current.Name,

					TextColor3 = Theme.Text,

					TextSize = 10,

					Font = Theme.Font,

					Parent = Row,
				}, {
					corner(5),
				})

				Row.MouseButton1Click:Connect(function()
					listening = true
					Key.Text = "..."

					local connection

					connection = UserInputService.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							current = input.KeyCode
							Key.Text = current.Name

							listening = false

							connection:Disconnect()
						end
					end)
				end)

				UserInputService.InputBegan:Connect(function(input, processed)
					if processed then
						return
					end

					if not listening
						and input.UserInputType == Enum.UserInputType.Keyboard
						and input.KeyCode == current then

						if options.Callback then
							options.Callback()
						end
					end
				end)

				local Object = {}

				function Object:Set(key)
					current = key
					Key.Text = current.Name
				end

				function Object:Get()
					return current
				end

				return Object
			end

			--// GRAPH

			function PanelObject:AddGraph(options)
				options = options or {}

				local points = options.Points or 30
				local height = options.Height or 50
				local minimum = options.Min or 0

				local values = {}

				for i = 1, points do
					values[i] = minimum
				end

				local GraphFrame = create("Frame", {
					Size = UDim2.new(
						1,
						0,
						0,
						height + 26
					),

					BackgroundTransparency = 1,

					LayoutOrder = 70,

					Parent = PanelContent,
				})

				local GraphLabel = create("TextLabel", {
					Size = UDim2.new(
						1,
						0,
						0,
						20
					),

					BackgroundTransparency = 1,

					Text = options.Name or "Graph",

					TextColor3 = Theme.SubText,

					TextSize = Customization.TextSize.Small,

					Font = Theme.Font,

					TextXAlignment = Enum.TextXAlignment.Left,

					Parent = GraphFrame,
				})

				local Graph = create("Frame", {
					Position = UDim2.fromOffset(0, 22),

					Size = UDim2.new(
						1,
						0,
						0,
						height
					),

					BackgroundColor3 = Theme.Panel,

					ClipsDescendants = true,

					Parent = GraphFrame,
				}, {
					corner(5),
				})

				local function redraw()
					for _, child in ipairs(Graph:GetChildren()) do
						if child:IsA("Frame") then
							child:Destroy()
						end
					end

					local width = Graph.AbsoluteSize.X

					if width <= 0 then
						return
					end

					for i = 1, #values - 1 do
						local valueA = values[i]
						local valueB = values[i + 1]

						local x1 = (i - 1) / (#values - 1)
						local x2 = i / (#values - 1)

						local y1 = 1 - math.clamp(
							(valueA - minimum)
								/ math.max(1, valueA),
							0,
							1
						)

						local y2 = 1 - math.clamp(
							(valueB - minimum)
								/ math.max(1, valueB),
							0,
							1
						)

						local x = x1 * width
						local nextX = x2 * width

						local segmentWidth = math.max(
							1,
							nextX - x
						)

						local segment = create("Frame", {
							Size = UDim2.fromOffset(
								segmentWidth,
								2
							),

							Position = UDim2.fromOffset(
								x,
								y1 * height
							),

							BackgroundColor3 = Theme.Accent,

							BorderSizePixel = 0,

							Parent = Graph,
						})

						segment.Rotation = math.deg(
							math.atan2(
								(y2 - y1) * height,
								segmentWidth
							)
						)
					end
				end

				Graph:GetPropertyChangedSignal("AbsoluteSize"):Connect(redraw)

				local Object = {}

				function Object:Push(value)
					table.remove(values, 1)
					table.insert(values, value)

					redraw()
				end

				return Object
			end

			Tab.Panels[panelIndex] = PanelObject

			return PanelObject
		end

		return Tab
	end

	--// OPTIONAL CENTERING

	if Customization.Behavior.AutoCenter then
		MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		MainFrame.Position = UDim2.fromScale(0.5, 0.5)
	end

	return WindowObject
end

