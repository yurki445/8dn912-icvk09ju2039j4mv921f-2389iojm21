			BackgroundColor3 = Theme.Accent,
			Active = true,
			ZIndex = 55,
			Parent = MainFrame,
		}, {
			corner(5)
		})

		ResizeHandle.InputBegan:Connect(function(input)
			if
				(Customization.Drag.Mouse and input.UserInputType == Enum.UserInputType.MouseButton1)
				or
				(Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch)
			then
				resizing = true
				resizeStart = input.Position
				startSize = MainFrame.AbsoluteSize

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
					end
				end)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if
				input.UserInputType ~= Enum.UserInputType.MouseMovement
				and not (
					Customization.Drag.Touch
					and input.UserInputType == Enum.UserInputType.Touch
				)
			then
				return
			end

			if resizing then
				local delta = input.Position - resizeStart

				local minX, minY = 560, 420

				local newX = math.max(
					minX,
					startSize.X + delta.X
				)

				local newY = math.max(
					minY,
					startSize.Y + delta.Y
				)

				MainFrame.Size = UDim2.fromOffset(newX, newY)

			elseif dragging then
				local delta = input.Position - dragStart

				MainFrame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end)
	end

	-- Change the theme for this window.
	-- The theme affects newly-created elements and the main window immediately.
	function Window:SetTheme(themeName)
		local selectedTheme = Themes[themeName]

		if not selectedTheme then
			warn(
				"Lib: unknown theme '"
					.. tostring(themeName)
					.. "'. Use Lib.Themes to see available themes."
			)
			return
		end

		applyTheme(selectedTheme)

		self.ThemeName = themeName

		MainFrame.BackgroundColor3 = Theme.Background
		MainStroke.Color = Theme.Accent

		for _, listener in ipairs(self._accentListeners) do
			listener(Theme.Accent)
		end
	end

	-- Change this window's accent color live.
	function Window:SetAccentColor(colorOrPresetName)
		local color = colorOrPresetName

		if type(colorOrPresetName) == "string" then
			color = Lib.Presets[colorOrPresetName]

			if not color then
				warn(
					"Lib: unknown accent preset '"
						.. tostring(colorOrPresetName)
						.. "'"
				)
				return
			end
		end

		if typeof(color) ~= "Color3" then
			warn("Lib: SetAccentColor expects a Color3 or preset name.")
			return
		end

		Theme.Accent = color

		for _, listener in ipairs(self._accentListeners) do
			listener(color)
		end
	end

	-- Allows scripts to manually unload this window.
	function Window:Destroy()
		if self.ScreenGui and self.ScreenGui.Parent then
			self.ScreenGui:Destroy()
		end
	end

	Lib._lastWindow = Window

	return Window
end

-- Change the accent color live.
-- Accepts either a Color3 or the name of a Lib.Presets entry
-- (e.g. "Blue"). Updates every element that has registered itself
-- as accent-aware (window border, active toggles, etc.) and affects
-- any new elements created afterward.

function Lib:SetAccentColor(colorOrPresetName)
	local color = colorOrPresetName

	if type(colorOrPresetName) == "string" then
		color = Lib.Presets[colorOrPresetName]

		if not color then
			warn(
				"Lib: unknown accent preset '"
					.. tostring(colorOrPresetName)
					.. "'"
			)
			return
		end
	end

	if typeof(color) ~= "Color3" then
		warn("Lib: SetAccentColor expects a Color3 or preset name.")
		return
	end

	-- Keep the color as the default for elements created afterward.
	Theme.Accent = color

	-- If a window has been created, update that window too.
	if Lib._lastWindow and Lib._lastWindow.SetAccentColor then
		Lib._lastWindow:SetAccentColor(color)
	end
end
