				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -90, 1, 0),
				Parent = Wrap,
			})

			local KeyStroke = stroke(Theme.PanelBorder, 1)
			local Box = create("Frame", {
				Size = UDim2.fromOffset(80, 20),
				Position = UDim2.new(1, -80, 0, 0),
				BackgroundColor3 = Theme.SliderTrack,
				Parent = Wrap,
			}, { corner(6), KeyStroke })

			local currentKey = cfg.Default

			local KeyLabel = create("TextLabel", {
				Text = currentKey and currentKey.Name or "None",
				Font = Theme.Font,
				TextSize = 12,
				TextColor3 = Theme.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Parent = Box,
			})

			local listening = false
			local Clicker = create("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				Parent = Box,
			})

			Clicker.MouseButton1Click:Connect(function()
				listening = true
				KeyLabel.Text = "..."
				tween(KeyStroke, { Color = Theme.Accent }, 0.15)
			end)

			UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then
					return
				end

				if listening then
					if input.KeyCode == Enum.KeyCode.Escape then
						-- cancel binding, keep previous key
						KeyLabel.Text = currentKey and currentKey.Name or "None"
					else
						currentKey = input.KeyCode
						KeyLabel.Text = currentKey.Name
						if cfg.OnBind then
							cfg.OnBind(currentKey)
						end
					end
					listening = false
					tween(KeyStroke, { Color = Theme.PanelBorder }, 0.15)
				elseif not gameProcessedEvent and currentKey and input.KeyCode == currentKey then
					if cfg.Callback then
						cfg.Callback()
					end
				end
			end)

			return Wrap
		end

		function PanelObj:AddGraph(cfg)
			cfg = cfg or {}
			order += 1

			local pointCount = cfg.Points or 30
			local fixedMin, fixedMax = cfg.Min, cfg.Max
			local barColor = cfg.Color or Theme.SliderFill

			local Wrap = create("Frame", {
				Size = UDim2.new(1, 0, 0, cfg.Height and (cfg.Height + 22) or 82),
				BackgroundTransparency = 1,
				LayoutOrder = order,
				Parent = Panel,
			})

			local NameLabel = create("TextLabel", {
				Text = cfg.Name or "graph",
				Font = Theme.Font,
				TextSize = 12,
				TextColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -60, 0, 16),
				Parent = Wrap,
			})

			local ValueLabel = create("TextLabel", {
				Text = "",
				Font = Theme.FontBold,
				TextSize = 12,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Right,
				BackgroundTransparency = 1,
				Position = UDim2.new(1, -60, 0, 0),
				Size = UDim2.fromOffset(60, 16),
				Parent = Wrap,
			})

			local GraphBox = create("Frame", {
				Size = UDim2.new(1, 0, 0, cfg.Height or 60),
				Position = UDim2.fromOffset(0, 20),
				BackgroundColor3 = Theme.SliderTrack,
				ClipsDescendants = true,
				Parent = Wrap,
			}, { corner(6), stroke(Theme.PanelBorder, 1) })

			local BarLayout = create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 1),
			})
			BarLayout.Parent = GraphBox

			local barWidthScale = 1 / pointCount
			local bars = {}
			local values = {}

			for i = 1, pointCount do
				values[i] = 0
				bars[i] = create("Frame", {
					Size = UDim2.new(barWidthScale, -1, 0, 0),
					BackgroundColor3 = barColor,
					LayoutOrder = i,
					Parent = GraphBox,
				}, { corner(2) })
			end

			local GraphObj = {}

			function GraphObj:Push(value)
				table.remove(values, 1)
				table.insert(values, value)

				local lo, hi = fixedMin, fixedMax
				if not lo or not hi then
					lo, hi = math.huge, -math.huge
					for _, v in ipairs(values) do
						lo = math.min(lo, v)
						hi = math.max(hi, v)
					end
					if lo == hi then
						hi = lo + 1
					end
				end

				for i, bar in ipairs(bars) do
					local v = values[i]
					local pct = math.clamp((v - lo) / (hi - lo), 0, 1)
					bar.Size = UDim2.new(barWidthScale, -1, pct, 0)
				end

				if cfg.ShowValue ~= false then
					local displayValue = value
					if cfg.Round then
						displayValue = math.floor(value * 10 ^ cfg.Round + 0.5) / 10 ^ cfg.Round
					end
					ValueLabel.Text = tostring(displayValue) .. (cfg.Suffix or "")
				end
			end

			return GraphObj
		end

		function PanelObj:AddTextbox(cfg)
			cfg = cfg or {}
			order += 1

			local Wrap = create("Frame", {
				Size = UDim2.new(1, 0, 0, 56),
				BackgroundTransparency = 1,
				LayoutOrder = order,
				Parent = Panel,
			})

			create("TextLabel", {
				Text = cfg.Name or "text",
				Font = Theme.Font,
				TextSize = 12,
				TextColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 16),
				Parent = Wrap,
			})

			local Box = create("Frame", {
				Size = UDim2.new(1, 0, 0, 32),
				Position = UDim2.fromOffset(0, 20),
				BackgroundColor3 = Theme.SliderTrack,
				Parent = Wrap,
			}, { corner(6), stroke(Theme.PanelBorder, 1) })

			local Input = create("TextBox", {
				Text = cfg.Default or "",
				PlaceholderText = cfg.Placeholder or "",
				Font = Theme.Font,
				TextSize = 13,
				TextColor3 = Theme.Text,
				PlaceholderColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -20, 1, 0),
				Parent = Box,
			})

			Input.FocusLost:Connect(function(enterPressed)
				if cfg.Callback then
					cfg.Callback(Input.Text, enterPressed)
				end
			end)

			return Wrap
		end
		return PanelObj
	end

	clickable.MouseButton1Click:Connect(function()
		for _, t in ipairs(self.Tabs) do
			t.Page.Visible = false
			t.Button.BackgroundColor3 = Theme.SidebarItem
		end
		Page.Visible = true
		Button.BackgroundColor3 = Theme.SidebarHover
		self.ActiveTab = Tab
	end)

	table.insert(self.Tabs, Tab)

	-- First tab added becomes active by default
	if #self.Tabs == 1 then
		Page.Visible = true
		Button.BackgroundColor3 = Theme.SidebarHover
		self.ActiveTab = Tab
	end

	return Tab
end

return Lib
