local function applyTheme(theme)
	Theme.Background = theme.Background or Theme.Background
	Theme.Panel = theme.ElementBackground or Theme.Panel
	Theme.PanelBorder = theme.ElementStroke or Theme.PanelBorder
	Theme.SidebarItem = theme.TabBackground or Theme.SidebarItem
	Theme.SidebarHover = theme.TabBackgroundSelected or Theme.SidebarHover
	Theme.Accent = theme.SliderProgress or Theme.Accent
	Theme.AccentDim = theme.SliderBackground or Theme.AccentDim
	Theme.Text = theme.TextColor or Theme.Text
	Theme.SubText = theme.PlaceholderColor or Theme.SubText
	Theme.SliderTrack = theme.SliderBackground or Theme.SliderTrack
	Theme.SliderFill = theme.SliderProgress or Theme.SliderFill
end

--// HELPERS ---------------------------------------------------------------

local function create(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color, thickness)
	return create("UIStroke", {
		Color = color or Theme.PanelBorder,
		Thickness = thickness or 1,
	})
end

local function tween(obj, props, time, style)
	TweenService:Create(obj, TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quad), props):Play()
end

