--[[
	Lib - a lightweight Roblox UI library

	USAGE:
	local Lib = require(path.to.Lib)

	local Window = Lib:CreateWindow({
		Title = "My UI",              -- optional, default "Kelo"
		ProfileName = "Player",       -- optional, defaults to your username
		ProfileTag = "v1.0",          -- optional, small tag next to your name
		Size = UDim2.fromOffset(700, 500), -- optional, default 860x620
		SidebarWidth = 200,           -- optional, default 220
		AccentColor = Color3.fromRGB(70, 145, 235), -- optional starting accent
	})

	local Tab = Window:AddTab({ Name = "Main", Subtitle = "Most Popular" })

	-- Panels group related controls. Three ways to make one:
	local A = Tab:AddPanel("Option")                                -- title + checkbox header (default)
	local B = Tab:AddPanel({ Title = "Info", Toggleable = false })   -- title only, no checkbox
	local C = Tab:AddPanel({ Toggleable = false })                   -- no header at all, just a box

	-- Everything below can be added to any panel (A, B, C, ...):
	Panel:AddLabel({ Text = "Plain text, e.g. section notes", Muted = true })
	Panel:AddDivider() -- a thin separator line
	Panel:AddToggle({ Name = "Enable thing", Default = false, Callback = function(on) end })
	Panel:AddSlider({ Name = "Amount", Min = 0, Max = 100, Default = 50, Callback = function(v) end })
	Panel:AddDropdown({ Name = "Mode", Options = {"A", "B"}, Default = "A", Callback = function(v) end })
	Panel:AddButton({ Name = "Do it", Accent = true, Callback = function() end })
	Panel:AddTextbox({ Name = "Label", Placeholder = "...", Callback = function(text, enterPressed) end })
	Panel:AddKeybind({ Name = "Bind", Default = Enum.KeyCode.E, Callback = function() end })
	local Graph = Panel:AddGraph({ Name = "FPS", Points = 30, Min = 0, Suffix = " fps" })
	Graph:Push(60) -- call this repeatedly (e.g. every frame) to feed the graph

	-- Themes:
	local Window = Lib:CreateWindow({ Theme = "Ocean" })
	-- Available themes: Default, Ocean, AmberGlow, Light, Amethyst, Green, Bloom, DarkBlue, Crimson, Monochrome
	Window:SetTheme("Crimson")
	Window:SetAccentColor("Blue") -- or Window:SetAccentColor(Color3.fromRGB(...))
	-- Presets: Lib.Presets.Green / .Blue / .Purple / .Red
	-- Full customization: Lib.Customization, Lib.Themes, Lib.Transparency, Lib.Style

	Window.MainFrame -- the root Frame, e.g. Window.MainFrame.Visible = false to hide the whole UI
	Window.Tabs      -- array of tabs in the order you added them, e.g. Window.Tabs[2]
]]


