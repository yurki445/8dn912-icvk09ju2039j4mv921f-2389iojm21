				local value = math.floor(min + (max - min) * rel)
				ValueLabel.Text = tostring(value) .. "%"
				if cfg.Callback then
					cfg.Callback(value)
				end
			end

			Track.InputBegan:Connect(function(input)
				if (Customization.Drag.Mouse and input.UserInputType == Enum.UserInputType.MouseButton1) or (Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch) then
					dragging = true
					updateFromX(input.Position.X)
