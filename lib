--// PANEL LAYOUT

-- Panels are positioned manually instead of using UIGridLayout.  A grid layout
-- cannot use each panel's automatic height, which is what caused panels with
-- different amounts of content to overlap.
local function setupPanelLayout(page)
	local state = {
		Connections = {},
		Updating = false,
	}

	local function getPanels()
		local panels = {}

		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("GuiObject") and child.Name ~= "PagePadding" then
				table.insert(panels, child)
			end
		end

		table.sort(panels, function(a, b)
			return (a.LayoutOrder or 0) < (b.LayoutOrder or 0)
		end)

		return panels
	end

	local function update()
		if state.Updating or not page.Parent then
			return
		end

		state.Updating = true

		local panels = getPanels()
		local pageWidth = page.AbsoluteSize.X
		local panelWidth = Customization.Size.PanelWidth
		local spacing = Customization.Size.Spacing
		local padding = Customization.Size.Padding

		if pageWidth <= 0 then
			state.Updating = false
			return
		end

		-- The page has its own 2px UIPadding. Work with the usable width so
		-- two columns always fit without touching or overlapping.
		local usableWidth = math.max(0, pageWidth - 4)
		local columns = 1

		if usableWidth >= (panelWidth * 2 + spacing) then
			columns = 2
		end

		local rowY = 0
		local rowHeight = 0

		for index, panel in ipairs(panels) do
			local column = (index - 1) % columns
			local row = math.floor((index - 1) / columns)

			if column == 0 then
				rowY = row == 0 and 0 or (rowY + rowHeight + spacing)
				rowHeight = 0
			end

			panel.Size = UDim2.fromOffset(panelWidth, math.max(40, panel.AbsoluteSize.Y))
			panel.Position = UDim2.fromOffset(
				column * (panelWidth + spacing),
				rowY
			)

			rowHeight = math.max(rowHeight, panel.AbsoluteSize.Y)
		end

		local totalHeight = rowY + rowHeight + padding
		page.CanvasSize = UDim2.fromOffset(0, math.max(0, totalHeight))

		state.Updating = false
	end

	local function watchPanel(panel)
		if not panel:IsA("GuiObject") then
			return
		end

		local connection = panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			task.defer(update)
		end)

		table.insert(state.Connections, connection)
	end

	page.ChildAdded:Connect(function(child)
		if child:IsA("GuiObject") and child.Name ~= "PagePadding" then
			watchPanel(child)
			task.defer(update)
		end
	end)

	page.ChildRemoved:Connect(function()
		task.defer(update)
	end)

	page:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(update)
	end)

	for _, child in ipairs(page:GetChildren()) do
		if child:IsA("GuiObject") and child.Name ~= "PagePadding" then
			watchPanel(child)
		end
	end

	-- Give automatic panel sizing one frame to settle before the first layout.
	task.defer(update)

	return state
end

