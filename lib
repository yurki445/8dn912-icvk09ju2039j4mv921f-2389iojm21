				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if (Customization.Drag.Mouse and input.UserInputType == Enum.UserInputType.MouseButton1) or (Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch) then
