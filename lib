		--// SLIDER ------------------------------------------------------

		function PanelObj:AddSlider(config)
			config = config or {}

			local name = config.Name or config.Title or "Slider"
			local min = config.Min or 0
			local max = config.Max or 100
			local default = config.Default
			local increment = config.Increment or 1

			if default == nil then
				default = min
			end

			default = math.clamp(default, min, max)

			local Row = create("Frame", {
				Name = name,
				Size = UDim2.new(1, 0, 0, 54),
				BackgroundTransparency = 1,
				LayoutOrder = #PanelObj.Elements + 1,
				Parent = Panel,
			})

			local Label = create("TextLabel", {
				Text = name,
				Font = Theme.Font,
				TextSize = Customization.TextSizes.Element,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -70, 0, 20),
				Parent = Row,
			})

			local ValueLabel = create("TextLabel", {
				Text = tostring(default),
				Font = Theme.FontBold,
				TextSize = Customization.TextSizes.Element,
				TextColor3 = Theme.Accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				BackgroundTransparency = 1,
				Position = UDim2.new(1, -70, 0, 0),
				Size = UDim2.fromOffset(70, 20),
				Parent = Row,
			})

			local SliderBack = create("Frame", {
				Size = UDim2.new(1, 0, 0, 6),
				Position = UDim2.fromOffset(0, 30),
				BackgroundColor3 = Theme.Slider,
				BackgroundTransparency = Customization.Transparency.Slider,
				Parent = Row,
			}, {
				corner(6)
			})

			local percentage = (default - min) / (max - min)

			local SliderFill = create("Frame", {
				Size = UDim2.new(percentage, 0, 1, 0),
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = Customization.Transparency.SliderFill,
				Parent = SliderBack,
			}, {
				corner(6)
			})

			local SliderButton = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 18),
				Position = UDim2.fromOffset(0, -6),
				Parent = SliderBack,
			})

			local value = default
			local dragging = false

			local function setValue(newValue, fireCallback)
				newValue = math.clamp(newValue, min, max)

				if increment > 0 then
					newValue = min
						+ math.floor(
							((newValue - min) / increment) + 0.5
						) * increment

					newValue = math.clamp(newValue, min, max)
				end

				value = newValue

				local percent

				if max == min then
					percent = 0
				else
					percent = (value - min) / (max - min)
				end

				tween(SliderFill, {
					Size = UDim2.new(percent, 0, 1, 0)
				}, 0.08)

				ValueLabel.Text = tostring(value)

				if fireCallback and config.Callback then
					config.Callback(value)
				end
			end

			SliderButton.MouseButton1Down:Connect(function()
				dragging = true
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					dragging = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if not dragging then
					return
				end

				if
					input.UserInputType ~= Enum.UserInputType.MouseMovement
					and input.UserInputType ~= Enum.UserInputType.Touch
				then
					return
				end

				local x = input.Position.X
				local startX = SliderBack.AbsolutePosition.X
				local width = SliderBack.AbsoluteSize.X

				if width <= 0 then
					return
				end

				local percent = math.clamp(
					(x - startX) / width,
					0,
					1
				)

				setValue(
					min + ((max - min) * percent),
					true
				)
			end)

			setValue(default, false)

			local SliderObj = {
				Frame = Row,
				Get = function()
					return value
				end,
				Set = function(_, newValue)
					setValue(newValue, true)
				end,
			}

			table.insert(PanelObj.Elements, SliderObj)

			return SliderObj
		end

