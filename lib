	local Window = setmetatable({
		ScreenGui = ScreenGui,
		MainFrame = MainFrame,
		TabContainer = TabContainer,
		ContentArea = ContentArea,
		Tabs = {},
		ActiveTab = nil,
		_accentListeners = {},
	}, Lib)

	-- The main window border tracks the accent color
	table.insert(Window._accentListeners, function(color)
		tween(MainStroke, { Color = color }, 0.2)
	end)

	-- The avatar badge background tracks the accent color (only visible
	-- when the real thumbnail failed to load)
	if not (ok and thumbnailContent) then
		table.insert(Window._accentListeners, function(color)
			tween(AvatarFrame, { BackgroundColor3 = color }, 0.2)
		end)
	end

	-- Drag the whole window from the header or any outer side/corner.
	-- A bottom-right resize handle is also provided.
	if Customization.Drag.Enabled then
		local dragging = false
		local dragStart = nil
		local startPos = nil
		local resizing = false
		local resizeStart = nil
		local startSize = nil

		local DragLayer = create("Frame", {
			Name = "DragLayer",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Active = false,
			ZIndex = 50,
			Parent = MainFrame,
		})

		local function beginDrag(input)
			if dragging or resizing then return end
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end

		local dragZones = {}
		local function makeDragZone(name, size, position)
			local zone = create("TextButton", {
				Name = name, Text = "", AutoButtonColor = false,
				Size = size, Position = position, BackgroundTransparency = 1,
				Active = true, ZIndex = 51, Parent = DragLayer,
			})
			zone.InputBegan:Connect(function(input)
				if (Customization.Drag.Mouse and input.UserInputType == Enum.UserInputType.MouseButton1)
					or (Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch) then
					beginDrag(input)
				end
			end)
			table.insert(dragZones, zone)
			return zone
		end

		-- Header and all four sides can start a move.
		makeDragZone("TopDrag", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 0))
		makeDragZone("LeftDrag", UDim2.new(0, 12, 1, -24), UDim2.fromOffset(0, 12))
		makeDragZone("RightDrag", UDim2.new(0, 12, 1, -24), UDim2.new(1, -12, 0, 12))
		makeDragZone("BottomDrag", UDim2.new(1, -80, 0, 12), UDim2.new(0, 12, 1, -12))

		local ResizeHandle = create("TextButton", {
			Name = "ResizeHandle", Text = "", AutoButtonColor = false,
			Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -22, 1, -22),
			BackgroundTransparency = 0.55, BackgroundColor3 = Theme.Accent,
			Active = true, ZIndex = 55, Parent = MainFrame,
		}, { corner(5) })

		ResizeHandle.InputBegan:Connect(function(input)
			if (Customization.Drag.Mouse and input.UserInputType == Enum.UserInputType.MouseButton1)
				or (Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch) then
				resizing = true
				resizeStart = input.Position
				startSize = MainFrame.AbsoluteSize
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then resizing = false end
				end)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and not (Customization.Drag.Touch and input.UserInputType == Enum.UserInputType.Touch) then return end
			if resizing then
				local delta = input.Position - resizeStart
				local minX, minY = 560, 420
				local newX = math.max(minX, startSize.X + delta.X)
				local newY = math.max(minY, startSize.Y + delta.Y)
				MainFrame.Size = UDim2.fromOffset(newX, newY)
			elseif dragging then
				local delta = input.Position - dragStart
				MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end)
	end

	-- Change the theme for this window.
	-- The theme affects newly-created elements and the main window immediately.
	function Window:SetTheme(themeName)
		local selectedTheme = Themes[themeName]
		if not selectedTheme then
			warn("Lib: unknown theme '" .. tostring(themeName) .. "'. Use Lib.Themes to see available themes.")
			return
		end

		applyTheme(selectedTheme)
		self.ThemeName = themeName
		MainFrame.BackgroundColor3 = Theme.Background
		MainStroke.Color = Theme.Accent
		for _, listener in ipairs(self._accentListeners) do
			listener(Theme.Accent)
		end
	end

	-- Allows scripts to manually unload this window.
	function Window:Destroy()
		if self.ScreenGui and self.ScreenGui.Parent then
			self.ScreenGui:Destroy()
		end
	end

	return Window
end

-- Change the accent color live. Accepts either a Color3 or the name of a
-- Lib.Presets entry (e.g. "Blue"). Updates every element that has
-- registered itself as accent-aware (window border, active toggles, etc.)
-- and affects any new elements created afterward.
function Lib:SetAccentColor(colorOrPresetName)
	local color = colorOrPresetName
	if type(colorOrPresetName) == "string" then
		color = Lib.Presets[colorOrPresetName]
		if not color then
			warn("Lib: unknown accent preset '" .. colorOrPresetName .. "'")
			return
		end
	end

	Theme.Accent = color
	for _, listener in ipairs(self._accentListeners) do
		listener(color)
	end
end

