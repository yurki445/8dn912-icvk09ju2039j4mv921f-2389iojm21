--// HELPERS ----------------------------------------------------------------

local function create(class, props, children)
	local inst = Instance.new(class)

	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end

	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end

	return inst
end

local function corner(radius)
	return create("UICorner", {
		CornerRadius = UDim.new(0, radius or 8)
	})
end

local function stroke(color, thickness)
	return create("UIStroke", {
		Color = color or Theme.PanelBorder,
		Thickness = thickness or 1,
	})
end

local function tween(obj, props, time, style)
	TweenService:Create(
		obj,
		TweenInfo.new(
			time or 0.2,
			style or Enum.EasingStyle.Quad
		),
		props
	):Play()
end

local function resolveIcon(icon)
	if icon == nil then
		return nil
	end

	if type(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end

	if type(icon) ~= "string" then
		return nil
	end

	if string.sub(icon, 1, 8) == "lucide:" then
		icon = string.sub(icon, 9)
	end

	if string.sub(icon, 1, 10) == "rbxassetid:" then
		return icon
	end

	return LucideIcons[icon] or LucideIcons[string.lower(icon)]
end

local function createIcon(parent, icon, size, color, position, zIndex)
	local image = resolveIcon(icon)

	if not image then
		return nil
	end

	return create("ImageLabel", {
		Name = "Icon",
		Image = image,
		ImageColor3 = color or Theme.Text,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(
			size or Customization.Size.Icon,
			size or Customization.Size.Icon
		),
		Position = position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = zIndex or 1,
		Parent = parent,
	})
end

