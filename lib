				Size = UDim2.new(1, -64, 1, 0),
				Parent = Row,
			})

			local ToggleBack = create("Frame", {
				Size = UDim2.fromOffset(42, 22),
				Position = UDim2.new(1, -42, 0.5, -11),
				BackgroundColor3 = Theme.Checkbox,
				BackgroundTransparency = Customization.Transparency.Checkbox,
				Parent = Row,
			}, {
				corner(12)
			})

			local ToggleFill = create("Frame", {
				Size = UDim2.fromOffset(18, 18),
				Position = UDim2.fromOffset(2, 2),
				BackgroundColor3 = Theme.SubText,
				Parent = ToggleBack,
			}, {
				corner(10)
			})

			local function updateToggle(fireCallback)
				if enabled then
					tween(ToggleBack, {
						BackgroundColor3 = Theme.Accent,
						BackgroundTransparency = 0,
					}, Customization.Animation.Duration)

					tween(ToggleFill, {
						Position = UDim2.new(1, -20, 0, 2),
						BackgroundColor3 = Theme.ActiveText,
					}, Customization.Animation.Duration)
				else
					tween(ToggleBack, {
						BackgroundColor3 = Theme.Checkbox,
						BackgroundTransparency = Customization.Transparency.Checkbox,
					}, Customization.Animation.Duration)

					tween(ToggleFill, {
						Position = UDim2.fromOffset(2, 2),
						BackgroundColor3 = Theme.SubText,
					}, Customization.Animation.Duration)
				end

				if fireCallback and config.Callback then
					config.Callback(enabled)
				end
			end

			Row.MouseButton1Click:Connect(function()
				enabled = not enabled
				updateToggle(true)
			end)

			updateToggle(false)

			local ToggleObj = {
				Frame = Row,

				Get = function()
					return enabled
				end,

				Set = function(_, state)
					enabled = state == true
					updateToggle(true)
				end,
			}

			table.insert(PanelObj.Elements, ToggleObj)

			return ToggleObj
		end
